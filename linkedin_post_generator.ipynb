      "cell_type": "code",
      "source": [
        "import google.generativeai as genai"
      ],
      "metadata": {
        "id": "syMFWbVS_3S-"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "API_KEY = \""\n",
        "\n",
        "genai.configure(api_key=API_KEY)"
      ],
      "metadata": {
        "id": "vtxxG-hhBUCt"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "model = genai.GenerativeModel(\"gemini-2.5-flash\")"
      ],
      "metadata": {
        "id": "z8VFTt9WBr78"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "topic = input(\"Enter your LinkedIn post topic: \")"
      ],
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "LPugOej_B5zE",
        "outputId": "0acaf267-ec8a-4fda-8c4e-391828e0e2f7"
      },
      "execution_count": null,
      "outputs": [
        {
          "name": "stdout",
          "output_type": "stream",
          "text": [
            "Enter your LinkedIn post topic: Women in tech\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "prompt = f\"\"\"\n",
        "Write a professional LinkedIn post about {topic}.\n",
        "\n",
        "Requirements:\n",
        "- Professional tone\n",
        "- Engaging introduction\n",
        "- 120 to 180 words\n",
        "- Add relevant hashtags\n",
        "- Make it suitable for students and professionals\n",
        "\"\"\""
      ],
      "metadata": {
        "id": "ZLuOvsYYCQW9"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "response = model.generate_content(prompt)"
      ],
      "metadata": {
        "id": "vIkPX0VNCWid"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "print(\"\\nGenerated LinkedIn Post:\\n\")\n",
        "print(response.text)"
      ],
